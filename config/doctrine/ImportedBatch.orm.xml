<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <entity name="Tmonier\SyliusErpFlatfilePlugin\Entity\ImportedBatch" table="tmonier_erp_flatfile_import_batch">
        <unique-constraints>
            <unique-constraint name="tmonier_erp_flatfile_import_batch_unique" columns="name,checksum" />
        </unique-constraints>

        <id name="id" column="id" type="string" length="36" />

        <field name="name" column="name" type="string" length="255" />
        <field name="checksum" column="checksum" type="string" length="64" />
        <field name="kind" column="kind" type="string" length="16" />
        <field name="outcome" column="outcome" type="string" length="16" />
        <field name="linesRead" column="lines_read" type="integer" />
        <field name="linesApplied" column="lines_applied" type="integer" />
        <field name="linesRejected" column="lines_rejected" type="integer" />
        <field name="report" column="report" type="text" />
        <field name="importedAt" column="imported_at" type="datetime_immutable" />
    </entity>

</doctrine-mapping>
